PORT=5000
# Production: use a MongoDB Atlas URI (MONGO_URI=memory is ephemeral dev-only
# and needs devDependencies installed to download the binary).
MONGO_URI=mongodb://127.0.0.1:27017/sympohub
# Production: set a long random secret. Server refuses to sign tokens without it.
JWT_SECRET=sympohub_secret_change_me
# Production: set to your deployed frontend origin(s), comma-separated.
# Unknown origins are rejected (CORS) when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173
# Set AUTO_SEED=false to skip auto-seeding on boot.
AUTO_SEED=true
